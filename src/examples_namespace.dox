/*!
 * \namespace examples
 *
 * \brief Example C++ code
 *
 * Classifiers defined in this namespace.
 *
 *   @startuml{examples_classes.png}
 *   scale max 500*500
 *   namespace examples {
 *       abstract class GenericThread {
 *           +GenericThread(void*)
 *           #{abstract} _execute()
 *           #_join()
 *           -{static} run(void*)
 *           -thread
 *       }
 *       abstract class Thread < ARGUMENT, RESULT > {
 *           +Thread(ARGUMENT*)
 *           +join()
 *           #execute()
 *       }
 *       abstract class Command {
 *           +{abstract} void execute()
 *       }
 *       class CompositeCommand {
 *           +void execute()
 *       }
 *       class CommandQueue {
 *           +void enqueue(Command*)
 *           #execute()
 *           -Command* dequeue()
 *           -void processCommands()
 *           -{static} void* run(void*)
 *       }
 *       class Monitor {
 *           -pthread_mutex_t mutex
 *           -pthread_cond_t condition
 *           +Mutex()
 *           +virtual ~Mutex()
 *           +void broadcast()
 *           +void signal()
 *           +void wait()
 *           -void lock()
 *           -void unlock()
 *       }
 *       class Lock {
 *           +Lock(Monitor&)
 *           +virtual ~Lock()
 *       }
 *       GenericThread <|-- Thread
 *       Thread <|-- CommandQueue
 *       CommandQueue "1" -> "0..*" Command : -queue
 *       CommandQueue *-left- Monitor : -monitor
 *       CommandQueue ..> Lock
 *       Lock *--> Monitor : -monitor
 *       CompositeCommand  o-up-> "0..*" Command : -commands
 *       CompositeCommand --|> Command
 *   }
 *   @enduml
 */