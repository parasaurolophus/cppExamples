/*!
 * \namespace examples
 *
 * \brief Example C++ code
 *
 * Classifiers defined in this namespace.
 *
 * @mermaid
 * classDiagram
 *     %% misdirect to work around namespace direction bug in mermaid
 *     direction LR
 *     note "VOIDp and RESULTp are used to denote void* and RESULT* types\nas a work-around for crippling defects in mermaid class member syntax"
 *     namespace examples {
 *         class GenericThread  {
 *             <<abstract>>
 *             -pthread_t thread
 *             +virtual ~GenericThread()
 *             #GenericThread(VOIDp)
 *             #_execute()*
 *             #_join()
 *             -run(void*) VOIDp$
 *         }
 *         note for Thread "This should be Thread&lt;ARGUMENT,RESULT&gt;\nbut mermaid is almost completely useless for C++"
 *         class Thread~ARGUMENT~{
 *             #Thread(ARGUMENT*)
 *             +join() RESULTp
 *             #execute()
 *         }
 *         class Command {
 *             <<abstact>>
 *             +execute()*
 *         }
 *         class CompositeCommand {
 *             +execute()
 *         }
 *         class CommandQueue {
 *             +void enqueue(Command*)
 *             #execute()
 *             -Command* dequeue()
 *             -void processCommands()
 *             -void* run(void*)$
 *         }
 *         class Monitor {
 *             -pthread_mutex_t mutex
 *             -pthread_cond_t condition
 *             +Mutex()
 *             +virtual ~Mutex()
 *             +void broadcast()
 *             +void signal()
 *             +void wait()
 *             -void lock()
 *             -void unlock()
 *         }
 *         class Lock {
 *             +Lock(Monitor&)
 *             +virtual ~Lock()
 *         }
 *     }
 *     GenericThread <|-- Thread
 *     Thread <|-- CommandQueue
 *     Command <|-- CompositeCommand
 *     CommandQueue "1" --> "0..*" Command : -queue
 *     CommandQueue *-- Monitor : -monitor
 *     CommandQueue ..> Lock
 *     Lock *--> Monitor : -monitor
 *     CompositeCommand  "1" o--> "0..*" Command : -commands
 * @endmermaid
 */